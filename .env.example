# Copy to .env and fill in YOUR values. .env is git-ignored and must never be committed.
# Every doc and script in this repo refers to these names instead of real addresses.

LAN_CIDR=10.0.0.0/24            # your LAN subnet
GATEWAY_IP=10.0.0.1             # router
WAZUH_IP=10.0.0.12              # static IP for the Wazuh VM (outside the DHCP pool, or reserved)
WAZUH_VMID=110                  # Proxmox VM ID for the Wazuh VM
WAZUH_NODE=pve2                 # Proxmox node that hosts the Wazuh VM
WAZUH_STORAGE=local-lvm         # Proxmox storage for the VM disk
ISO_STORAGE=local               # Proxmox storage holding the Ubuntu ISO
UBUNTU_ISO=ubuntu-24.04.4-live-server-amd64.iso

SENSOR_NODE=pve3                # node that runs Suricata
ADGUARD_HOST=adguard            # container that runs AdGuard Home
